{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "AmbarksCloud",
  "favicon": {
    "light": "/images/favicon.ico",
    "dark": "/images/favicon.ico"
  },
  "colors": {
    "primary": "#2563eb",
    "light": "#e5e5e5",
    "dark": "#0f1219"
  },
  "navigation": {
    "groups": [
      {
        "group": "Comece aqui",
        "pages": [
          "index",
          "inicio/quickstart"
        ]
      },
      {
        "group": "Deploy pelo dashboard",
        "pages": [
          "projetos/criando-projetos",
          "projetos/deploy-zip",
          "projetos/deploy-github"
        ]
      },
      {
        "group": "Configure seu projeto",
        "pages": [
          "projetos/runtimes",
          "projetos/ambarks-json",
          "projetos/dockerfile",
          "projetos/variaveis-ambiente",
          "projetos/portas-dominios"
        ]
      },
      {
        "group": "Gerencie sua aplicação",
        "pages": [
          "projetos/logs-metricas",
          "projetos/containers",
          "projetos/billing-limites"
        ]
      },
      {
        "group": "Guias por stack",
        "pages": [
          "guias/visao-geral",
          "guias/discord-bot-node",
          "guias/express",
          "guias/vite",
          "guias/nextjs",
          "guias/fastapi",
          "guias/flask"
        ]
      },
      {
        "group": "Ajuda",
        "pages": [
          "exemplos/projetos-exemplo",
          "troubleshooting/common-errors",
          "faq"
        ]
      }
    ]
  },
  "description": "Plataforma de deploy e hospedagem de aplicações web",
  "logo": "/images/logo-color-complete-2.png",
  "background": {
    "decoration": "grid",
    "color": {
      "light": "#e5e5e5",
      "dark": "#0c0d11"
    }
  },
  "appearance": {
    "default": "dark",
    "strict": false
  },
  "fonts": {
    "family": "Poppins",
    "weight": 500
  },
  "thumbnails": {
    "appearance": "dark",
    "background": "/images/wallpaper.png"
  }
}
